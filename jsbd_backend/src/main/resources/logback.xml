<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="true">
    <!-- 系统文件输出 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前正在记录的日志文件的路径及文件名 -->
        <file>D:/javalogs/app.log</file>

        <!-- 日志记录器的滚动策略，按日期和大小记录 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 归档日志文件的路径及文件名格式：日期 + 索引（ %i 用于处理同一天内大小超限的情况） -->
            <fileNamePattern>D:/javaLogs/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 每个日志文件的最大大小，超出后生成新文件 -->
            <maxFileSize>10MB</maxFileSize>
            <!-- 保留历史日志的天数 -->
            <maxHistory>30</maxHistory>
            <!-- 所有归档日志文件的总大小上限（可选，用于防止磁盘爆满） -->
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>

        <!-- 日志输出格式 -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- 控制台输出 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!--格式化输出：%d表示日期，%thread表示线程名，%-5level：级别从左显示5个字符宽度 %logger{50}：最长50个字符(超出,切割) %msg：日志消息，%n是换行符 -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>


    <!-- 日志输出级别 -->
    <root level="info">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>